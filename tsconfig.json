{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"types": ["@playwright/test", "node"]
	},
	"include": ["tests/e2e/**/*.ts", "playwright.config.ts"],
	"exclude": ["node_modules"]
}
