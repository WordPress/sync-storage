{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post-new.php",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/gutenberg/releases/download/v23.9.0-rc.1/gutenberg.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php update_option( 'gutenberg-experiments', array( 'gutenberg-real-time-collaboration' => 1 ) );"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/demo-seeder.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/sync-storage/main/tests/e2e/demo-seeder.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/rtc-demo-helper.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/sync-storage/main/tests/e2e/rtc-demo-helper.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require_once '/wordpress/wp-content/mu-plugins/demo-seeder.php'; sync_storage_demo_seed( 5 );"
		}
	]
}
