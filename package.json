{
	"name": "realtime-collaboration",
	"private": true,
	"scripts": {
		"env:start": "bash build-gutenberg.sh && wp-env start",
		"env:stop": "wp-env stop",
		"env:cli": "wp-env run cli wp",
		"env:logs": "docker exec -it $(docker ps -q --filter \"name=realtime-collaboration.*wordpress-1\") tail -f /var/www/html/wp-content/debug.log",
		"test": "wp-env run tests-cli --env-cwd='wp-content/plugins/realtime-collaboration' -- ./vendor/bin/phpunit --testdox"
	},
	"devDependencies": {
		"@wordpress/env": "^11.12.0"
	}
}
